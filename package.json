{
  "name": "alpicois-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd backend && node api-server.js",
    "dev:all": "node -e \"const{spawn}=require('child_process');const api=spawn('node',['api-server.js'],{stdio:'inherit',cwd:'backend'});const vite=spawn('npx',['vite'],{stdio:'inherit',cwd:'.'});process.on('SIGINT',()=>{api.kill();vite.kill();process.exit()})\"",
    "rebuild": "node backend/rebuild-conversations.js",
    "enrich": "node backend/enrich-contacts.js",
    "fix-bodies": "node backend/fix-email-bodies.js",
    "format-names": "node backend/format-names.js",
    "extract-profiles": "node backend/extract-profile.js",
    "export-data": "node backend/export-static-data.js",
    "refresh": "npm run refresh --prefix backend",
    "refresh:signals": "npm run refresh --prefix backend -- --skip-imap",
    "setup-personal": "node backend/setup-personal-contact.js",
    "prepare-templates": "node backend/prepare-templates.js",
    "prebuild": "npm run export-data && npm run prepare-templates && npm run bundle-db && npm run copy-wasm",
    "copy-wasm": "node scripts/copy-docx-wasm.mjs",
    "bundle-db": "node scripts/bundle-deploy-db.mjs",
    "build": "tsc -b && vite build",
    "test": "npm run test:all --prefix backend",
    "lint": "eslint .",
    "preview": "vite preview",
    "e2e:prod": "node scripts/e2e-prod-test.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript-eslint": "^8.58.2"
  }
}
