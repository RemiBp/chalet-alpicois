# IMAP Hostinger
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
EMAIL_USER=contact@alpicois-laplagne.fr
EMAIL_PASS=your-email-password-here

# DeepSeek — validation IA des réservations (optionnel, recommandé en prod)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_RECONCILE_LIMIT=15
# AI_RECONCILE_DRY_RUN=0

# OpenAI API Key (fallback legacy)
OPENAI_API_KEY=sk-votre-cle-openai

# Mode admin (production) — mot de passe pour activer les écritures depuis l'URL publique
ADMIN_PASSWORD=votre-mot-de-passe-admin
# Optionnel : secret HMAC (sinon ADMIN_PASSWORD sert de secret)
# ADMIN_SECRET=

# Cron Vercel (2×/jour) — refresh emails + statuts réservation
# CRON_SECRET=un-secret-long-aleatoire

# Vercel Blob — persistance SQLite en production (lier un Blob store au projet Vercel)
# BLOB_READ_WRITE_TOKEN=auto-injecté-par-vercel
# Première mise en prod : npm run upload-db-blob --prefix backend

# Email IMAP (brouillons mail)
DB_PATH=../emails.db
